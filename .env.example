# Copy to .env (git-ignored). Path to the JSON key of the service account
# orange-you-glad@static-pottery-465109-b6.iam.gserviceaccount.com. The "Orange You Glad" Drive
# folder must be shared with that email (Viewer). Keep the key under /secrets/ (git-ignored).
# Then run `just drive-auth`.
GDRIVE_SERVICE_ACCOUNT_FILE=secrets/orange-you-glad.sa.json
# Key of the Editor service account orange-writer@static-pottery-465109-b6.iam.gserviceaccount.com, used only by scripts/intake.ps1 (git-ignored under secrets/).
GDRIVE_WRITER_SERVICE_ACCOUNT_FILE=secrets/orange-writer.sa.json
