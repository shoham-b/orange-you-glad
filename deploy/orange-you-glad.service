[Unit]
Description=Orange You Glad photo-collage slideshow
Documentation=https://github.com/shoham-b/orange-you-glad
After=local-fs.target

[Service]
Type=simple
User=orange-you-glad
Group=orange-you-glad
SupplementaryGroups=video
ExecStart=/usr/local/bin/orange-you-glad --config /etc/orange-you-glad.toml
Environment=RUST_LOG=info
Restart=always
RestartSec=5

# Hardening. The service needs the framebuffer, read access to the photo library, and nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
DevicePolicy=closed
DeviceAllow=/dev/fb0 rw
ReadOnlyPaths=/var/lib/orange-you-glad
# Same user as the sync job, so hide the Drive credentials from the slideshow.
InaccessiblePaths=-/var/lib/orange-you-glad/rclone.conf -/var/lib/orange-you-glad/service-account.json
# Keep a runaway process from starving the 1 GB board.
MemoryMax=600M

[Install]
WantedBy=multi-user.target
