[Unit]
Description=Sync photos from Google Drive with rclone
Documentation=https://github.com/shoham-b/orange-you-glad
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

[Service]
Type=oneshot
User=orange-you-glad
Group=orange-you-glad
Environment=RCLONE_CONFIG=/var/lib/orange-you-glad/rclone.conf
# The remote "gdrive" must already be configured (see docs/DEPLOY.md). Its root_folder_id
# points at the shared folder, so the remote root holds Incoming/, Processed/, Errored/ and
# Config/. Only Processed/ and Config/ are mirrored; the other two belong to the intake agent.
ExecStart=/usr/bin/rclone sync gdrive: /var/lib/orange-you-glad/photos \
  --ignore-case \
  --include "/Processed/*.{jpg,jpeg,png,webp}" \
  --include "/Config/*.{json,toml}" \
  --include "/orange-you-glad.toml" \
  --max-size 25M \
  --max-delete 50 \
  --drive-skip-gdocs \
  --transfers 2 \
  --log-level INFO
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/orange-you-glad
TimeoutStartSec=1h
# rclone buffers directory listings; keep it from starving the slideshow on the 1 GB board.
MemoryMax=300M
